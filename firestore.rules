rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function google() {return signedIn() && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
    function active() { return google() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['member','superadmin']; }
    function admin() { return active() && request.auth.token.email == 'joel.yc23@gmail.com' && get(/databases/$(database)/documents/system/bootstrap).data.uid == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'; }
    function scope(team, brand) { return active() && (admin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/access/$(team + '__' + brand)) && get(/databases/$(database)/documents/teams/$(team)/brands/$(brand)).data.archived == false)); }
    match /campaignDrafts/{id} {allow read: if admin();allow write: if false;}
    match /users/{uid} {
      allow read: if google() && (request.auth.uid == uid || admin());
      allow write: if false;
      match /memberships/{team} {allow read: if google() && (request.auth.uid == uid || admin()); allow write: if false;}
      match /access/{key} { allow read: if google() && (request.auth.uid == uid || admin()); allow write: if false; }
    }
    match /teams/{team}/brands/{brand} {
      allow read: if scope(team, brand);
      allow write: if false;
      match /{collection}/{record} {
        allow read: if scope(team, brand) && collection in ['orders', 'decks', 'campaigns','dependencies','people'];
        allow write: if false;
        match /{childCollection}/{child} {
          allow read: if scope(team, brand) && collection == 'orders' && childCollection in ['pieces','comments','deliveries','activity','followers'];
          allow write: if false;
        }
      }
    }
    match /recurrences/{id} {allow read: if admin(); allow write: if false;}
    match /recurrenceRuns/{id} {allow read: if admin(); allow write: if false;}
    match /recurrenceExecutions/{id} {allow read: if admin(); allow write: if false;}
    match /notifications/{uid}/items/{item} {
      allow read: if google() && request.auth.uid == uid && scope(resource.data.teamId, resource.data.brandId);
      allow write: if false;
    }
    match /siteContent/public {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['revision','updatedAt']) && request.resource.data.revision is int && request.resource.data.updatedAt == request.time && ((!exists(/databases/$(database)/documents/siteContent/public) && request.resource.data.revision == 1) || request.resource.data.revision == resource.data.revision+1);
      match /texts/{key} {
        allow read: if true;
        function contentChange() {let p=/databases/$(database)/documents/siteContent/public;return getAfter(p).data.revision == (exists(p)?get(p).data.revision:0)+1 && getAfter(p).data.updatedAt == request.time;}
        allow create, update: if admin() && contentChange() && key in ["browser.title","App.79cf00c63e3c","App.a6903434865f","App.1f5f611ebddc","App.c8bd1dbf6a8e","App.ab51f6ea5985","App.b4031248c6e3","App.d5077e256157","App.d4ff39621b13","App.c6e6960395f4","Admin.de0b0f8f8b23","Admin.ff4ef7bb68e9","Admin.b0a0fda6ddf8","Admin.4b1ac40eef4b","Admin.fe5f6628c7b5","Admin.36254c5cf260","Admin.20489f9611a1","Admin.d6d9b1a55f30","Admin.617739ba49c7","Admin.579a66916cc4","Admin.0c8dd4dea714","Admin.49de7ef6b77a","Admin.b4802d8e7f27","Admin.5d87613802f3","Admin.551d103d4afc","Admin.45d597041997","Admin.df1455d2ad8e","Admin.b5406b2b2cdb","Admin.50f73b2e9c72","Admin.4c482fc8e335","Admin.6c67315861e1","Admin.cde1d1905ca2","Admin.f68396df0f4f","Admin.6079adae9766","Admin.86a3507997b0","Admin.3c8dc4dc7a83","Admin.14bdfaf2face","Admin.99cc7f05e7b8","Admin.acc2e245d5b9","Admin.20c6595373c9","Admin.f5e0c56ebe83","Admin.8cbe82eda079","Admin.e3fe2c142111","Admin.eac5386d4211","Admin.c29446754ae1","Admin.4ec4f22c0de0","Admin.8e2ca9b0cc8a","Admin.9a18ec717586","Admin.a0119ade46d0","Admin.32942ac76458","Admin.3dbcdefb3a7d","Admin.c0f88fdbafae","Admin.3868d2843d59","Admin.0119803da011","Admin.42e4a9196c01","Admin.db0a626efa9c","Admin.3423bcbbed75","Admin.dbae0b2a1a74","Admin.da34705158a7","Admin.471a9efb7112","Admin.bc013a1ac62f","Admin.3df0647047e9","Admin.ca0844ff9a18","Admin.97603bc6e7f7","Admin.22228d5392a3","Admin.ff9801cd7ded","Admin.1292453e92bb","Admin.91318b4c3d39","Admin.ee00b96fff26","Admin.f7d130b9b886","Admin.5840f09cd7a7","Admin.9648ee05ec00","Admin.44561a782151","Admin.8930e00fcc39","Admin.292d514f1df6","Admin.73e1804eb968","Admin.399b037dab0f","Admin.997dfc14fbb1","Admin.eada91217f03","Admin.709152ffc04d","Admin.1571fa2151cd","Admin.f928ca764ee1","Admin.0af00080a949","Admin.9aa5406e7588","Admin.9372a186ffa5","Admin.44023599b021","Admin.c1a10fe619c4","Admin.6c48d42dab0f","Admin.4c950851c680","Admin.28b47b21c30e","Admin.b9dbba30935c","Admin.3428f69a017a","Admin.076362212a37"