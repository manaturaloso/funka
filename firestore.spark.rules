rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function google() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function active() { let p=get(/databases/$(database)/documents/users/$(request.auth.uid)).data; return google() && p.active == true && p.role in ['member','superadmin']; }
    function ownerIdentity() {return google() && request.auth.token.email == 'joel.yc23@gmail.com';}
    function admin() {return ownerIdentity() && get(/databases/$(database)/documents/system/bootstrap).data.uid == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';}
    function scope(team,brand) {
      let p=get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return google() && p.active == true && p.role in ['member','superadmin']
        && ((request.auth.token.email == 'joel.yc23@gmail.com' && p.role=='superadmin' && get(/databases/$(database)/documents/system/bootstrap).data.uid==request.auth.uid)
          || ((!('invitationId' in p) || p.scopes.hasAny([{'teamId':team,'brandId':brand}])) && exists(/databases/$(database)/documents/users/$(request.auth.uid)/access/$(team+'__'+brand)) && get(/databases/$(database)/documents/teams/$(team)/brands/$(brand)).data.archived==false));
    }
    function authored() { return request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time; }
    function brandImage(value) { return value == null || (value is string && value.size() <= 350000 && value.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')); }
    function validInvitation(d) {
      let invitation=get(/databases/$(database)/documents/invitations/$(d.invitationId)).data;
      return google() && d.invitationId is string && d.invitationId.matches('^[a-f0-9]{64}$')
        && invitation.active == true && invitation.email.lower() == request.auth.token.email.lower()
        && d.email == request.auth.token.email.lower() && d.active == true && d.role == 'member'
        && d.invitationRevision == invitation.revision && d.scopes == invitation.scopes && d.teamIds == invitation.teamIds;
    }
    function claimingInvitation(uid) {
      let path=/databases/$(database)/documents/users/$(uid);
      let after=getAfter(path).data;
      return google() && uid == request.auth.uid
        && (!exists(path) || get(path).data.role == 'pending')
        && after.updatedAt == request.time && validInvitation(after);
    }
    function calendarWorker() {return signedIn() && request.auth.uid=='calendar-sync' && request.auth.token.get('calendarSync',false)==true && request.auth.token.firebase.sign_in_provider=='custom';}
    function runningCalendar() {let d=get(/databases/$(database)/documents/calendarSync/state).data;return calendarWorker() && d.status=='running' && d.leaseOwner==request.auth.uid && d.leaseExpiresMillis>request.time.toMillis();}
    function calendarRow(d) {return d is map && d.title is string && d.title.size()>0 && d.title.size()<=2000 && d.sheet is string && d.sheet.size()<=100 && d.range is string && d.range.size()<=100 && d.start is string && d.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.end is string && d.end>=d.start && d.get('channelHints',[]) is list && d.get('channelHints',[]).hasOnly(['WP','SIS']) && d.issues is list && d.issues.size()<=20;}
    function calendarSourceReceipt(id,missing) {
      let run=get(/databases/$(database)/documents/calendarSync/state).data.runId;
      let path=/databases/$(database)/documents/adminActivity/$((missing?'calendar-missing-':'calendar-source-')+run+'-'+id);
      return getAfter(path).data.actorUid==request.auth.uid && getAfter(path).data.createdAt==request.time && getAfter(path).data.campaignId==id;
    }
    function calendarSourceUpdate(id) {
      let old=resource.data;let d=request.resource.data;let previous=old.get('sourceLatest',old.source);
      return runningCalendar() && d.revision==old.revision+1 && d.updatedAt==request.time
        && d.diff(old).affectedKeys().hasOnly(['title','start','end','sourceLatest','sourceMissing','syncStatus','syncConflicts','revision','updatedAt'])
        && calendarRow(d.get('sourceLatest',old.source)) && d.sourceMissing is bool && d.syncStatus in ['updated','manual','missing']
        && d.get('syncConflicts',[]) is list && d.get('syncConflicts',[]).hasOnly(['title','start','end','channels'])
        && (d.title==old.title || (old.title==previous.title && d.title==d.sourceLatest.title))
        && (d.start==old.start || (old.start==previous.start && d.start==d.sourceLatest.start))
        && (d.end==old.end || (old.end==previous.end && d.end==d.sourceLatest.end))
        && d.end>=d.start && calendarSourceReceipt(id,d.sourceMissing);
    }
    match /calendarSync/{id} {
      allow read: if admin() || calendarWorker();
      allow write: if admin();
      allow create,update: if id=='state' && calendarWorker()
        && request.resource.data.keys().hasOnly(['status','runId','leaseOwner','leaseUntil','leaseExpiresMillis','revision','lastAttemptAt','updatedAt','lastSuccessDay','lastSuccessAt','lastRequestId','sourceSha256','contentHash','settingsHash','counts','error'])
        && request.resource.data.leaseOwner==request.auth.uid && request.resource.data.runId is string && request.resource.data.runId.size()<=80
        && request.resource.data.status in ['running','success','error'] && request.resource.data.updatedAt==request.time
        && request.resource.data.revision==(exists(/databases/$(database)/documents/calendarSync/state)?resource.data.revision:0)+1
        && request.resource.data.leaseExpiresMillis is int && request.resource.data.leaseExpiresMillis<=request.time.toMillis()+1260000
        && (!exists(/databases/$(database)/documents/calendarSync/state) || resource.data.status!='running' || resource.data.leaseExpiresMillis<request.time.toMillis() || request.resource.data.runId==resource.data.runId);
    }
    match /calendarChanges/{id} {
      allow read: if admin() || calendarWorker();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision','status','revision','decidedBy','decidedAt']) && resource.data.status=='pending' && request.resource.data.status=='decided' && request.resource.data.revision==resource.data.revision+1 && request.resource.data.decidedBy==request.auth.uid && request.resource.data.decidedAt==request.time && (request.resource.data.decision==null || request.resource.data.decision in resource.data.candidates);
      allow create: if runningCalendar() && id.matches('^cal-[a-f0-9]{64}$') && calendarRow(request.resource.data.row) && request.resource.data.status=='pending' && request.resource.data.revision==1 && request.resource.data.candidates is list && request.resource.data.candidates.size()<=2000 && request.resource.data.createdAt==request.time;
      allow update: if runningCalendar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['row','candidates','candidateLabels','sourceSignature','status','revision','updatedAt']) && request.resource.data.status in ['pending','applied'] && request.resource.data.revision==resource.data.revision+1 && request.resource.data.updatedAt==request.time;
      allow delete: if false;
    }
    function campaignLinkValue(d) {return {'teamId':d.teamId,'brandId':d.brandId,'orderId':d.orderId,'mode':d.mode};}
    function campaignLinkReceipt(id,channel,before,after) {
      let path=/databases/$(database)/documents/campaignDrafts/$(id);
      let c=getAfter(path).data;
      let r=getAfter(/databases/$(database)/documents/adminActivity/$('campaign-links-'+id+'__'+string(c.revision))).data;
      return admin() && c.revision==get(path).data.revision+1 && c.updatedAt==request.time
        && r.action=='campaignLinks' && r.campaignId==id && r.actorUid==request.auth.uid && r.createdAt==request.time
        && r.before[channel]==before && r.after[channel]==after
        && getAfter(/databases/$(database)/documents/system/sparkGuard).data.updatedAt==request.time
        && getAfter(/databases/$(database)/documents/system/sparkGuard).data.revision==get(/databases/$(database)/documents/system/sparkGuard).data.revision+1;
    }
    function repairedCampaignLink(id,channel,before) {
      let d=request.resource.data;
      let c=getAfter(/databases/$(database)/documents/campaignDrafts/$(id)).data;
      let target=get(/databases/$(database)/documents/teams/$(d.teamId)/brands/$(d.brandId)/orders/$(d.orderId)).data;
      let previousPath=/databases/$(database)/documents/campaignDrafts/$(id)/orders/$(channel);
      let previous=exists(previousPath)?get(previousPath).data:{};
      return channel in ['WP','SIS'] && c.channels.hasAny([channel])
        && d.keys().hasOnly(['teamId','brandId','orderId','mode','campaignRevision','actorUid','createdAt'])
        && d.teamId==c.teamId && d.brandId==c.brandId && d.campaignRevision==c.revision
        && d.actorUid==request.auth.uid && d.createdAt==request.time
        && (target.get('channel',null)==null || target.channel==channel)
        && (d.mode=='linked' || (d.mode=='created' && previous.get('mode','')=='created' && previous.get('teamId','')==d.teamId && previous.get('brandId','')==d.brandId && previous.get('orderId','')==d.orderId && target.campaign.id==id))
        && campaignLinkReceipt(id,channel,before,campaignLinkValue(d));
    }
    match /campaignDrafts/{id} {
      match /orders/{channel} {
        allow read: if admin() || calendarWorker();
        allow create: if admin() && repairedCampaignLink(id,channel,null);
        allow update: if admin() && repairedCampaignLink(id,channel,campaignLinkValue(resource.data));
        allow delete: if admin() && campaignLinkReceipt(id,channel,campaignLinkValue(resource.data),null);
        allow create: if admin() && channel in ['WP','SIS'] && request.resource.data.keys().hasOnly(['teamId','brandId','orderId','mode','campaignRevision','actorUid','createdAt']) && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.mode in ['linked','created'] && get(/databases/$(database)/documents/campaignDrafts/$(id)).data.reviewed == true && get(/databases/$(database)/documents/campaignDrafts/$(id)).data.channels.hasAny([channel]) && request.resource.data.campaignRevision == get(/databases/$(database)/documents/campaignDrafts/$(id)).data.revision && request.resource.data.teamId == get(/databases/$(database)/documents/campaignDrafts/$(id)).data.teamId && request.resource.data.brandId == get(/databases/$(database)/documents/campaignDrafts/$(id)).data.brandId && existsAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/brands/$(request.resource.data.brandId)/orders/$(request.resource.data.orderId));
      }
      allow read: if admin() || calendarWorker();
      allow create, delete: if false;
      allow create: if runningCalendar() && id.matches('^cal-[a-f0-9]{64}$') && request.resource.data.keys().hasOnly(['id','title','start','end','channels','teamId','brandId','reviewed','revision','sourceSha256','source','sourceLatest','syncStatus','sourceMissing','syncConflicts','createdAt','updatedAt']) && request.resource.data.id==id && request.resource.data.reviewed==false && request.resource.data.teamId==null && request.resource.data.brandId==null && request.resource.data.revision==1 && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && calendarRow(request.resource.data.source) && request.resource.data.title==request.resource.data.source.title && request.resource.data.start==request.resource.data.source.start && request.resource.data.end==request.resource.data.source.end && request.resource.data.channels==request.resource.data.source.channelHints && calendarSourceReceipt(id,false);
      allow update: if calendarWorker() && calendarSourceUpdate(id);
      function destination() {let d=request.resource.data;return (d.teamId == null && d.brandId == null) || (d.teamId is string && d.brandId is string && exists(/databases/$(database)/documents/teams/$(d.teamId)/brands/$(d.brandId)) && get(/databases/$(database)/documents/teams/$(d.teamId)/brands/$(d.brandId)).data.archived == false);}
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','start','end','channels','teamId','brandId','reviewed','syncStatus','syncConflicts','revision','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=2000
        && request.resource.data.start is string && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.end is string && request.resource.data.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.end>=request.resource.data.start
        && request.resource.data.channels is list && request.resource.data.channels.hasOnly(['WP','SIS']) && request.resource.data.channels.size()<=2 && request.resource.data.channels.toSet().size()==request.resource.data.channels.size()
        && destination() && request.resource.data.reviewed is bool && (!request.resource.data.reviewed || (request.resource.data.teamId != null && request.resource.data.channels.size()>0))
        && request.resource.data.revision == resource.data.revision+1 && request.resource.data.updatedAt == request.time;
    }
    match /branding/public {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['logoData','symbolData','headerWidth','revision','updatedAt']) && request.resource.data.get('headerWidth',180) is int && request.resource.data.get('headerWidth',180)>=100 && request.resource.data.get('headerWidth',180)<=280 && brandImage(request.resource.data.logoData) && brandImage(request.resource.data.symbolData) && request.resource.data.updatedAt == request.time && ((!exists(/databases/$(database)/documents/branding/public) && request.resource.data.revision == 1) || (resource.data.revision + 1 == request.resource.data.revision));
    }
    function preferenceChange(uid) {
      return active() && uid == request.auth.uid && getAfter(/databases/$(database)/documents/users/$(uid)).data.active == true && getAfter(/databases/$(database)/documents/users/$(uid)).data.preferencesRevision == get(/databases/$(database)/documents/users/$(uid)).data.get('preferencesRevision',0) + 1 && getAfter(/databases/$(database)/documents/users/$(uid)).data.preferencesUpdatedAt == request.time;
    }
    function followerChange(team,brand,order) {
      let path=/databases/$(database)/documents/teams/$(team)/brands/$(brand)/orders/$(order)/followerGuard/global;
      return getAfter(path).data.revision == (exists(path)?get(path).data.revision:0)+1 && getAfter(path).data.updatedAt == request.time;
    }
    function viewFilters(f) {
      return f is map && f.keys().hasOnly(['audience','archived','view','search','scopeFilter','statusFilter','period','channel','priority','typeFilter','teamFilter','brandFilter','responsibleFilter','fromDate','toDate'])
        && f.audience in ['mine','brands'] && f.archived is bool && f.view in ['board','list','calendar']
        && f.search is string && f.search.size() <= 200 && f.scopeFilter is string && f.scopeFilter.size() <= 162
        && f.statusFilter in ['','Por asignar','Pendiente','En proceso','En revisión','Entregado','Bloqueado','Esperando material','Por validar','En pausa','Por subir'] && f.period in ['','today','late','next']
        && f.channel in ['','WP','SIS'] && f.priority in ['','Baja','Media','Normal','Alta','Urgente']
        && f.typeFilter is string && f.typeFilter.size() <= 100
        && f.teamFilter is string && f.teamFilter.size() <= 80 && f.brandFilter is string && f.brandFilter.size() <= 80 && f.responsibleFilter is string && f.responsibleFilter.size() <= 80
        && f.fromDate is string && f.fromDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && f.toDate is string && f.toDate.matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /system/bootstrap {
      allow get: if google();
      allow create: if ownerIdentity() && request.resource.data.keys().hasOnly(['uid','email','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.createdAt == request.time && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
      allow update, delete: if false;
    }
    match /system/sparkGuard {
      allow get: if google() || calendarWorker();
      allow list: if active();
      allow create: if (active() || claimingInvitation(request.auth.uid) || calendarWorker()) && request.resource.data.keys().hasOnly(['revision','updatedAt']) && request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time;
      allow update: if (active() || claimingInvitation(request.auth.uid) || calendarWorker()) && request.resource.data.keys().hasOnly(['revision','updatedAt']) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /system/adminGuard {allow read, write: if admin();}
    match /users/{uid} {
      allow read: if google() && (request.auth.uid == uid || admin());
      allow create: if google() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','email','displayName','googleVerified','authProvider','active','role','scopes','teamIds','revision','createdAt']) && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200 && request.resource.data.googleVerified == true && request.resource.data.authProvider == 'google.com' && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.scopes == [] && request.resource.data.teamIds == [] && ((request.resource.data.active == false && request.resource.data.role == 'pending') || (ownerIdentity() && getAfter(/databases/$(database)/documents/system/bootstrap).data.uid == uid && request.resource.data.active == true && request.resource.data.role == 'superadmin'));
      allow create: if google() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','googleVerified','authProvider','active','role','scopes','teamIds','revision','createdAt','updatedAt','invitationId','invitationRevision'])
        && request.resource.data.uid == uid && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200
        && request.resource.data.googleVerified == true && request.resource.data.authProvider == 'google.com'
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && validInvitation(request.resource.data);
      allow update: if google() && uid == request.auth.uid && resource.data.role == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','active','role','scopes','teamIds','revision','updatedAt','invitationId','invitationRevision'])
        && request.resource.data.revision == resource.data.revision+1 && request.resource.data.updatedAt == request.time
        && validInvitation(request.resource.data);
      allow update: if (active() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferencesRevision','preferencesUpdatedAt']) && request.resource.data.preferencesRevision == resource.data.get('preferencesRevision',0)+1 && request.resource.data.preferencesUpdatedAt == request.time) || (admin() && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email && request.resource.data.googleVerified == resource.data.googleVerified && request.resource.data.authProvider == resource.data.authProvider && request.resource.data.createdAt == resource.data.createdAt && (request.resource.data.role != 'superadmin' || uid == get(/databases/$(database)/documents/system/bootstrap).data.uid) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time && (uid != get(/databases/$(database)/documents/system/bootstrap).data.uid || (request.resource.data.active == true && request.resource.data.role == 'superadmin')));
      allow delete: if admin() && uid != get(/databases/$(database)/documents/system/bootstrap).data.uid;
      match /access/{key} {
        allow read: if google() && (uid == request.auth.uid || admin()); allow write: if admin();
        allow create, update: if claimingInvitation(uid) && request.resource.data.keys().hasOnly(['teamId','brandId'])
          && key == request.resource.data.teamId+'__'+request.resource.data.brandId
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.scopes.hasAny([request.resource.data]);
      }
      match /brandAccess/{brand} {
        allow read: if google() && (uid == request.auth.uid || admin());
        allow write: if admin();
        allow create, update: if claimingInvitation(uid) && request.resource.data.keys().hasOnly(['teamId','brandId'])
          && request.resource.data.brandId == brand && getAfter(/databases/$(database)/documents/users/$(uid)).data.scopes.hasAny([request.resource.data]);
      }
      match /views/{viewId} {
        allow read: if active() && (uid == request.auth.uid || admin());
        allow create, update: if preferenceChange(uid) && request.resource.data.keys().hasOnly(['name','filters','revision','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && viewFilters(request.resource.data.filters) && request.resource.data.updatedAt == request.time && ((!exists(/databases/$(database)/documents/users/$(uid)/views/$(viewId)) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time) || (request.resource.data.revision == resource.data.revision+1 && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if admin() || preferenceChange(uid);
      }
      match /memberships/{team} {
        allow read: if google() && (uid == request.auth.uid || admin()); allow write: if admin();
        allow create, update: if claimingInvitation(uid) && request.resource.data.keys().hasOnly(['teamId']) && request.resource.data.teamId == team
          && team in getAfter(/databases/$(database)/documents/users/$(uid)).data.teamIds;
      }
    }
    function imageNames(d) {
      let images=d.get('detailImages',[]);
      return images.size()==0?[]:(images.size()==1?[{'id':images[0].id,'name':images[0].name}]:[{'id':images[0].id,'name':images[0].name},{'id':images[1].id,'name':images[1].name}]);
    }
    function snapshotMatches(snapshot,d) {
      let keys=['id','teamId','brandId','title','description','type','channel','priority','assigneeUid','collaborators','deadline','status','pieces','assignedUids','createdBy','revision','archived','deadlineMode','review','deliveryUrl','deckWarning','block','deck','orderTemplate','dependencies','campaignName','estimatedMinutes','assignedOn','socialNetwork','postingDate','deliveryException'];
      return snapshot is map && snapshot.keys().hasOnly(keys.concat(['detailImages']))
        && snapshot.diff(d).affectedKeys().intersection(keys.toSet()).size()==0 && snapshot.get('detailImages',[])==imageNames(d);
    }
    function orderPath(team,brand,order) {return /databases/$(database)/documents/teams/$(team)/brands/$(brand)/orders/$(order);}
    function receiptPath(team,brand,order,revision) {return /databases/$(database)/documents/adminActivity/$('collab-'+team+'__'+brand+'__'+order+'__'+string(revision));}
    function hasReceipt(team,brand,order) {
      let d=request.resource.data;
      let event=getAfter(receiptPath(team,brand,order,d.revision)).data;
      let activity=getAfter(/databases/$(database)/documents/teams/$(team)/brands/$(brand)/orders/$(order)/activity/$(d.lastOperationId)).data;
      return getAfter(/databases/$(database)/documents/system/sparkGuard).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/system/sparkGuard).data.revision == (exists(/databases/$(database)/documents/system/sparkGuard)?get(/databases/$(database)/documents/system/sparkGuard).data.revision:0)+1
        && event.actorUid == request.auth.uid && event.createdAt == request.time
        && activity.actorUid == request.auth.uid && activity.createdAt == request.time && activity.revision == d.revision && event.action == 'order.'+activity.action;
    }
    function optionalText(d,key,max) {return d.get(key,'') is string && d.get(key,'').size()<=max;}
    function validOrderFields(d,team,brand) {
      let directory=get(/databases/$(database)/documents/teams/$(team)/brands/$(brand)/collaboration/directory).data.uids;
      let settings= /databases/$(database)/documents/settings/general;
      let required=exists(settings)?get(settings).data.get('requiredFields',[]):[];
      return d.title is string && d.title.size()>0 && d.title.size()<=200
        && d.description is string && d.description.size()<=10000
        && d.type is string && d.type.size()>0 && d.type.size()<=100 && d.channel in [null,'WP','SIS']
        && d.priority in ['Alta','Media','Baja','Normal','Urgente']
        && d.status in ['Por asignar','Pendiente','En proceso','Esperando material','Por validar','En pausa','Entregado','Por subir','En revisión','Bloqueado']
        && (d.assigneeUid == null || d.assigneeUid in directory)
        && d.collaborators is list && d.collaborators.size()<=50 && d.collaborators.hasOnly(directory)
        && d.assignedUids is list && d.assignedUids.size()<=151 && d.assignedUids.hasOnly(directory)
        && (d.deadline == null || (d.deadline is string && d.deadline.size()<=40))
        && d.archived is bool && d.review in ['Pendiente','Aprobado','Requiere ajustes']
        && d.deadlineMode in ['manual','automatic'] && d.pieces is list && d.pieces.size()<=100
        && d.get('detailImages',[]) is list && d.get('detailImages',[]).size()<=2
        && optionalText(d,'campaignName',200) && optionalText(d,'socialNetwork',100)
        && (d.get('estimatedMinutes',null)==null || (d.estimatedMinutes is int && d.estimatedMinutes>0 && d.estimatedMinutes<=100000))
        && (!required.hasAny(['assigneeUid']) || d.assigneeUid!=null)
        && (!required.hasAny(['deadline']) || d.deadline!=null)
        && (!required.hasAny(['channel']) || d.channel!=null);
    }
